# Administrador PostgreSQL. Host interno: postgres, puerto: 5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Usuarios PostgreSQL fijos: n8n y redmine, respectivamente
N8N_DB_PASSWORD=
REDMINE_DB_PASSWORD=
