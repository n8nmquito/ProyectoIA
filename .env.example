# Copiar a .env y completar. No subir .env al repositorio.
SERVER_HOST=localhost
BIND_ADDRESS=0.0.0.0
N8N_PORT=5678
REDMINE_PORT=3000

# n8n inicia sesion con email; Redmine con usuario admin.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Hash bcrypt de la clave elegida para n8n (puede ser la misma de Redmine).
# Generar en el servidor (solicita la clave sin mostrarla):
# docker run --rm -it httpd:2.4-alpine htpasswd -nBC 12 admin
# Copiar solo el hash, sin el prefijo admin:, entre comillas simples.
N8N_OWNER_PASSWORD_HASH=''

# Generar un valor independiente para cada variable: openssl rand -hex 32
N8N_DB_PASSWORD=
REDMINE_DB_PASSWORD=
POSTGRES_ADMIN_PASSWORD=
N8N_ENCRYPTION_KEY=
REDMINE_SECRET_KEY_BASE=
