# Direccion y puertos de acceso
SERVER_HOST=localhost
BIND_ADDRESS=0.0.0.0
N8N_PORT=5678
REDMINE_PORT=3000

# Usuarios de aplicaciones y clave inicial compartida
ADMIN_EMAIL=admin@example.com
REDMINE_ADMIN_USER=admin
